{
  "rules": {
    ".read": "auth != null && (auth.token.workspaceMember === true || (auth.token.firebase.sign_in_provider === 'github.com' && (auth.token.firebase.identities['github.com'][0] === '174987576' || auth.token.firebase.identities['github.com'][0] === '19548351' || auth.token.firebase.identities['github.com'][0] === '286001688')))",
    ".write": "auth != null && (auth.token.workspaceMember === true || (auth.token.firebase.sign_in_provider === 'github.com' && (auth.token.firebase.identities['github.com'][0] === '174987576' || auth.token.firebase.identities['github.com'][0] === '19548351' || auth.token.firebase.identities['github.com'][0] === '286001688')))",
    "users": {
      ".write": false
    },
    "pm": {
      "projects": {
        "$project_id": {
          ".validate": "newData.hasChildren(['id', 'name', 'status', 'github', 'createdAt', 'updatedAt', 'updatedBy'])",
          "id": { ".validate": "newData.val() == $project_id" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "status": { ".validate": "newData.val() == 'active' || newData.val() == 'paused' || newData.val() == 'closed'" },
          "github": { ".validate": "newData.hasChildren(['owner', 'repo'])" }
        }
      },
      "milestones": {
        "$milestone_id": {
          ".validate": "newData.hasChildren(['id', 'projectId', 'name', 'status', 'createdAt', 'updatedAt', 'updatedBy'])",
          "id": { ".validate": "newData.val() == $milestone_id" },
          "projectId": { ".validate": "newData.isString() && newData.val().length > 0" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
          "status": { ".validate": "newData.val() == 'open' || newData.val() == 'closed'" },
          "dueDate": { ".validate": "newData.isString()" }
        }
      },
      "tasks": {
        "$task_id": {
          ".validate": "newData.hasChildren(['id', 'projectId', 'milestoneId', 'title', 'status', 'dueDate', 'priority', 'createdAt', 'updatedAt', 'updatedBy']) && newData.child('id').val() == $task_id && newData.child('projectId').isString() && newData.child('milestoneId').isString() && (newData.child('status').val() == 'backlog' || (newData.child('assignees').hasChildren() && newData.child('dueDate').isString() && newData.child('dueDate').val().length > 0))",
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
          "status": { ".validate": "newData.val() == 'backlog' || newData.val() == 'todo' || newData.val() == 'in_progress' || newData.val() == 'review' || newData.val() == 'blocked' || newData.val() == 'done'" },
          "priority": { ".validate": "newData.val() == 'high' || newData.val() == 'medium' || newData.val() == 'low'" },
          "dueDate": { ".validate": "newData.isString()" }
        }
      },
      "settings": {
        "slackChannel": { ".validate": "newData.isString()" },
        "timezone": { ".validate": "newData.val() == 'Asia/Tokyo'" }
      }
    },
    "workLogs": {
      "$log_id": {
        ".validate": "newData.hasChildren(['taskId', 'date', 'minutes', 'user'])",
        "taskId": { ".validate": "newData.isNumber() || newData.isString()" },
        "date": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
        "minutes": { ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    }
  }
}
